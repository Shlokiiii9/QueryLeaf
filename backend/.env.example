# GreenRoute Gateway Configuration
PORT=8000
ENVIRONMENT=development

# Edge MongoDB (Local / Factory cluster)
EDGE_MONGO_URI=mongodb://localhost:27017/edge_iot_db

# Cloud MongoDB (Central Regional Warehouse)
CLOUD_MONGO_URI=mongodb://localhost:27018/cloud_iot_warehouse

# Redis Cache
REDIS_URI=redis://localhost:6379/0

# Default Objective Function Weights (alpha + beta + gamma = 1.0)
ROUTING_ALPHA_LATENCY=0.45
ROUTING_BETA_ENERGY=0.40
ROUTING_GAMMA_COST=0.15

# Default Policy: adaptive | cache_first | cloud_only | fixed_rule
ACTIVE_POLICY=adaptive
